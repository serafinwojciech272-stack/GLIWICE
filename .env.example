# Extra Szpieg — provider configuration (server-side only; never put secrets in VITE_*).
# Every provider is optional. Missing credentials never block startup or marketplace search.

# --- Allegro (priority provider) ---
# OAuth endpoints live in the Vercel serverless API (/api/allegro/*).
# The marketplace gateway reuses the same OAuth session cookie; no second flow.
ALLEGRO_ENVIRONMENT=sandbox
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
ALLEGRO_REDIRECT_URI=https://YOUR_DOMAIN/api/allegro/oauth?action=callback
ALLEGRO_SESSION_SECRET=

# --- eBay (DISABLED by product policy; optional, never required) ---
# Leave EBAY_ENABLED unset/false. Credentials are not needed and not requested.
EBAY_ENABLED=false

# --- Other providers (registered, adapters not implemented) ---
# OLX_CLIENT_ID=
# OLX_CLIENT_SECRET=
# CENEO_API_KEY=
# AMAZON_LWA_CLIENT_ID=
# AMAZON_LWA_CLIENT_SECRET=
# EMPIK_API_KEY=
# TEMU_APP_KEY=
# TEMU_APP_SECRET=
# ERLI_API_KEY=
# KAUFLAND_CLIENT_KEY=
# KAUFLAND_SECRET_KEY=

# --- Gateway runtime ---
# Restricts CORS to the deployed frontend origin (defaults to *).
# FRONTEND_ORIGIN=https://your-frontend.example

# --- Browser-visible configuration only; never put secrets here ---
VITE_ALLEGRO_SEARCH_PHRASE=
VITE_REAL_SOURCE_URL=
